PUERTO=3000
DB_HOST=localhost
DB_PUERTO=5432
DB_NOMBRE=los_olivos_conectados
DB_USUARIO=postgres
DB_CLAVE=
# Clave secreta aleatoria de al menos 32 bytes; definir un valor privado en el entorno local.
JWT_SECRET=
# Directorio privado fuera de cualquier carpeta publicada por HTTP. En desarrollo
# se usa backend/private-audio si se omite; en despliegue conviene una ruta persistente.
REPORTES_AUDIO_DIR=
# Carpeta privada y persistente para fotos y videos; se usa backend/private-evidencias si se omite.
REPORTES_EVIDENCIAS_DIR=
